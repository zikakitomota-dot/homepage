---
import BaseLayout from "@/layouts/BaseLayout.astro"
import AdSlot from "@/components/AdSlot.astro"
import { HEALTH_ADVERTISING_ENABLED } from "@/config/advertising"
import { getCalculator, relatedCalculators } from "@/data/calculators"

interface FaqItem {
  q: string
  a: string
}

interface SourceItem {
  label: string
  href: string
  note: string
}

interface Props {
  title: string
  description: string
  heading: string
  intro: string
  slug: string
  faqs: FaqItem[]
  canonical?: string
  breadcrumbLabel?: string
  relatedSlugs?: string[]
  sources?: SourceItem[]
  reviewedDate?: string
}

const {
  title,
  description,
  heading,
  intro,
  slug,
  faqs,
  canonical,
  breadcrumbLabel,
  relatedSlugs,
  sources = [],
  reviewedDate,
} = Astro.props
const breadcrumbName = breadcrumbLabel ?? heading
const canonicalURL = canonical ?? new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).href
const requestedRelated = relatedSlugs
  ?.map((relatedSlug) => getCalculator(relatedSlug))
  .filter((calculator) => calculator !== undefined)
const related = requestedRelated?.length
  ? requestedRelated
  : relatedCalculators(slug, 4)

const faqJsonLd = {
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
}

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    faqJsonLd,
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Health Calculators",
          item: "https://zaleastudio.com/health",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: breadcrumbName,
          item: canonicalURL,
        },
      ],
    },
  ],
}
---

<BaseLayout title={title} description={description} canonical={canonical} jsonLd={jsonLd}>
  <section class="detail-hero"><div class="detail-hero-inner">
    <a class="back-link" href="/health"><span aria-hidden="true">←</span> All Health Calculators</a>
    <p class="section-badge">Free health calculator</p>
    <h1>{heading}</h1>
    <p class="lead">{intro}</p>
  </div></section>

  <div class={`calc-layout${HEALTH_ADVERTISING_ENABLED ? "" : " calc-layout--without-ads"}`}>
    <div>
      <section class="tool-region"><slot name="tool" /></section>

      {
        Astro.slots.has("content") ? (
          <>
            <div class="detail-content-grid"><slot name="content" /></div>
            <AdSlot variant="horizontal" label="Advertisement space (responsive)" />
          </>
        ) : (
          <>
            <!-- Formula explanation -->
            <section class="prose" aria-labelledby="formula-heading">
              <h2 id="formula-heading">How it works</h2>
              <slot name="formula" />
            </section>

            <AdSlot variant="horizontal" label="Advertisement space (responsive)" />

            <!-- Worked example -->
            <section class="prose" aria-labelledby="example-heading">
              <h2 id="example-heading">Example calculation</h2>
              <div class="example-box">
                <slot name="example" />
              </div>
            </section>
          </>
        )
      }

      {Astro.slots.has("decision") && <div class="decision-region"><slot name="decision" /></div>}

      {
        sources.length > 0 && (
          <section class="prose methodology info-panel" aria-labelledby="methodology-heading">
            <h2 id="methodology-heading">Methodology and sources</h2>
            <p>
              This calculator produces an estimate from the method described on
              this page. The references below document the underlying formula,
              comparison values, or important limitations; they do not turn the
              result into an individual medical recommendation.
            </p>
            <ul>
              {sources.map((source) => (
                <li>
                  <a href={source.href} target="_blank" rel="noreferrer">
                    {source.label}
                  </a>{" "}
                  — {source.note}
                </li>
              ))}
            </ul>
            <p>
              <strong>Published and maintained by Zalea Studio.</strong> Read the
              <a href="https://zaleastudio.com/editorial-standards">editorial standards</a>
              or <a href="https://zaleastudio.com/contact">report a calculation or content issue</a>.
            </p>
            {reviewedDate && <p class="review-date"><strong>Editorial and technical review:</strong> {reviewedDate}. This confirms a check of the formula, source links, worked explanation, limitations and implementation; it is not a medical review.</p>}
          </section>
        )
      }

      <!-- FAQ -->
      <section class="faq detail-section" aria-labelledby="faq-heading">
        <h2 id="faq-heading">Frequently asked questions</h2>
        {
          faqs.map((f) => (
            <details>
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))
        }
      </section>

      <!-- Related calculators -->
      <section class="related detail-section" aria-labelledby="related-heading">
        <h2 id="related-heading">Related calculators</h2>
        <ul class="related-links">
          {
            related.map((c) => (
              <li>
                <a href={`/health/calculators/${c.slug}`}>{c.name}</a>
              </li>
            ))
          }
        </ul>
      </section>

      <p class="disclaimer-note">
        This tool is for general educational purposes only and does not provide
        medical advice, diagnosis, or treatment. Talk to a qualified healthcare
        professional before making health decisions. Read our
        <a href="/health/disclaimer">health disclaimer</a>.
      </p>
    </div>

    {
      HEALTH_ADVERTISING_ENABLED && (
        <div class="sidebar">
          <AdSlot label="Advertisement space" />
          <AdSlot label="Advertisement space" />
        </div>
      )
    }
  </div>
</BaseLayout>
