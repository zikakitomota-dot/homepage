---
// Keep in step with components/site-footer.tsx on the main site.
const groups = [
  { title: "Explore", links: [
    { href: "/games", label: "Games" }, { href: "/health", label: "Health Calculators" },
    { href: "/guides", label: "Guides" }, { href: "/shop", label: "Shop" },
  ] },
  { title: "About Zalea", links: [
    { href: "/about", label: "About" }, { href: "/editorial-standards", label: "Editorial Standards" },
    { href: "/contact", label: "Contact" },
  ] },
  { title: "The fine print", links: [
    { href: "/privacy-policy", label: "Privacy Policy" }, { href: "/terms-of-use", label: "Terms of Use" },
    { href: "/health/disclaimer", label: "Health Disclaimer" },
  ] },
]
---

<footer class="global-footer">
  <div class="global-footer-inner">
    <div class="footer-main-row">
      <div class="footer-brand-block">
        <a href="/" class="footer-brand" style="font-family: var(--z-font-display); font-size: 1.25rem; font-weight: 700;"><span>Zalea Studio</span></a>
        <p>Explained calculators, learning activities, practical guides and original printables for everyday tasks.</p>
      </div>
      <nav class="footer-navigation" aria-label="Footer navigation">
        {groups.map((group) => (
          <div class="footer-group">
            <h2>{group.title}</h2>
            <ul>{group.links.map((link) => <li><a href={link.href}>{link.label}</a></li>)}</ul>
          </div>
        ))}
      </nav>
    </div>
    <div class="footer-meta">
      <p>Published and maintained by Zalea Studio · <a href="/editorial-standards">How content is prepared</a> · <a href="/contact">Report an issue</a></p>
      <p>© 2026 Zalea Studio. All rights reserved.</p>
    </div>
  </div>
</footer>
