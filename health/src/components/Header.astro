---
import { currentNavigationValue, navigation } from "../../../lib/navigation";
import "../../../components/site-navigation.css";
import NavigationItems from "./NavigationItems.astro";
const pathname = Astro.url.pathname;

---
<header class="zalea-header">
  <div class="zalea-header-inner">
    <a href="/" class="zalea-brand" aria-label="Zalea Studio home">
      <span class="zalea-brand-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="16" height="20" x="4" y="2" rx="2"></rect><line x1="8" x2="16" y1="6" y2="6"></line><line x1="16" x2="16" y1="14" y2="18"></line><path d="M16 10h.01M12 10h.01M8 10h.01M12 14h.01M8 14h.01M12 18h.01M8 18h.01"></path></svg></span>
      <span>Zalea Studio</span>
    </a>
    <nav class="zalea-desktop-nav" aria-label="Main navigation">
      <NavigationItems pathname={pathname} />
    </nav>
    <details class="zalea-mobile-navigation">
      <summary class="zalea-mobile-toggle" aria-label="Navigation menu"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"></path></svg><span>Menu</span></summary>
      <nav class="zalea-mobile-panel" aria-label="Mobile navigation">
        <NavigationItems pathname={pathname} />
        <div class="zalea-nav-utility">{navigation.utility.map(link => <a href={link.href} class="zalea-nav-item" aria-current={currentNavigationValue(pathname, link.href)}>{link.label}</a>)}</div>
      </nav>
    </details>
  </div>
</header>
<script>
  const header = document.querySelector('.zalea-header');
  header?.querySelectorAll('details').forEach(details => {
    details.querySelector(':scope > summary')?.setAttribute('aria-expanded', String(details.open));
  });
  const setClosed = (details: Element) => {
    details.removeAttribute('open');
    details.querySelector(':scope > summary')?.setAttribute('aria-expanded', 'false');
  };
  const close = () => header?.querySelectorAll('details[open]').forEach(setClosed);
  document.addEventListener('pointerdown', event => { if (!header?.contains(event.target as Node)) close(); });
  header?.addEventListener('click', event => { if ((event.target as Element).closest('a')) close(); });
  header?.addEventListener('keydown', event => {
    if ((event as KeyboardEvent).key !== 'Escape') return;
    const details = (event.target as Element).closest('details[open]') as HTMLDetailsElement | null;
    if (details) {
      event.preventDefault(); event.stopPropagation(); setClosed(details);
      details.querySelector<HTMLElement>(':scope > summary')?.focus();
    }
  });
  header?.addEventListener('focusout', event => {
    header.querySelectorAll('details[open]').forEach(details => { if (!details.contains((event as FocusEvent).relatedTarget as Node)) setClosed(details); });
  });
  header?.addEventListener('toggle', event => {
    const opened = event.target as HTMLDetailsElement;
    opened.querySelector(':scope > summary')?.setAttribute('aria-expanded', String(opened.open));
    if (opened.open) opened.parentElement?.querySelectorAll(':scope > details[open]').forEach(other => { if (other !== opened) setClosed(other); });
  }, true);
</script>
