# Server-only Resend credential. Never prefix this name with NEXT_PUBLIC_.
RESEND_API_KEY=re_replace_with_your_real_api_key

# The server sends from Zalea Studio <contact@mail.zaleastudio.com>.
# Verify mail.zaleastudio.com in Resend before enabling production delivery.

# Payhip Academy license verification. PAYHIP_PRODUCT_SECRET is server-only.
PAYHIP_PRODUCT_SECRET=
# Exact product_link returned by Payhip's v2 license verification response.
PAYHIP_PRODUCT_LINK=
# Public checkout/product page URL used by Academy purchase buttons.
NEXT_PUBLIC_PAYHIP_ACADEMY_URL=
